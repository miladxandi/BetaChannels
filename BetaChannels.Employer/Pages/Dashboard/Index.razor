@page "/"
@inject AppState AppState
@inject NavigationManager Navigation
@inject Shared.Interfaces.IFreelancerService FreelancerService
@inject Shared.Interfaces.IPaymentService PaymentService
@inject Shared.Interfaces.IContentCalendarService CalendarService

@if (!AppState.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
}
else
{
    <div class="app-header">
        <div class="header-top">
            <div class="app-logo">
                <div class="logo-icon">B</div>
                <div>
                    <div class="logo-text">Beta Channels</div>
                    <div style="font-size: 11px; opacity: 0.8;">پنل کارفرما</div>
                </div>
            </div>
            <div class="header-actions">
                <button class="header-btn">
                    <i class="bi bi-bell-fill"></i>
                    <span class="notification-badge">۲</span>
                </button>
                <button class="header-btn" @onclick="GoToProfile">
                    <i class="bi bi-person-fill"></i>
                </button>
                <button class="header-btn" @onclick="GoToSettings">
                    <i class="bi bi-gear-fill"></i>
                </button>
            </div>
        </div>

        <div class="welcome-card">
            <h2>سلام، @(AppState.UserFullName ?? "کارفرما") 👋</h2>
            <p>امروز @DateTime.Now.ToShamsiDateLong()</p>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon">📁</div>
            <div class="stat-value">@activeProjects.ToPersianDigits()</div>
            <div class="stat-label">پروژه فعال</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">✅</div>
            <div class="stat-value">@completedProjects.ToPersianDigits()</div>
            <div class="stat-label">تکمیل شده</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <div class="stat-value">@totalSpent</div>
            <div class="stat-label">هزینه کل</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-value">@freelancersCount.ToPersianDigits()</div>
            <div class="stat-label">فریلنسر فعال</div>
        </div>
    </div>

    @* تقویم کاری *@
    <div class="section-title">
        <h3>تقویم کاری</h3>
        <a href="/projects">مشاهده همه</a>
    </div>

    @if (upcomingEvents.Count == 0)
    {
        <div class="card" style="margin: 0 20px 16px; text-align: center; padding: 24px;">
            <p style="color: var(--text-secondary); font-size: 14px;">رویدادی در پیش نیست</p>
        </div>
    }
    else
    {
        @foreach (var ev in upcomingEvents.Take(3))
        {
            <div class="card" style="margin: 0 20px 12px; padding: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div style="flex: 1;">
                        <h4 style="font-size: 15px; margin-bottom: 4px;">@ev.Title</h4>
                        <p style="font-size: 13px; color: var(--text-secondary);">@ev.Description</p>
                        <div style="display: flex; gap: 8px; margin-top: 8px; align-items: center;">
                            <span style="background: rgba(255,107,53,0.15); color: var(--primary); padding: 3px 10px; border-radius: 12px; font-size: 11px;">
                                @ev.Platform.ToPersianName()
                            </span>
                            <span style="font-size: 11px; color: var(--text-secondary);">
                                @ev.ScheduledDate.ToShamsiDateLong()
                            </span>
                        </div>
                    </div>
                    <span style="background: @(ev.Status == ContentStatus.Published ? "rgba(76,175,80,0.15)" : ev.Status == ContentStatus.Scheduled ? "rgba(255,193,7,0.15)" : "rgba(176,176,176,0.15)"); color: @(ev.Status == ContentStatus.Published ? "var(--success)" : ev.Status == ContentStatus.Scheduled ? "var(--warning)" : "var(--text-secondary)"); padding: 4px 10px; border-radius: 20px; font-size: 11px;">
                        @ev.Status.ToPersianName()
                    </span>
                </div>
            </div>
        }
    }

    @* پروژه‌های فعال *@
    <div class="section-title">
        <h3>پروژه‌های فعال</h3>
        <a href="/projects">مشاهده همه</a>
    </div>

    @foreach (var project in activeProjectList)
    {
        <div class="card" style="margin: 0 20px 12px; padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                <h4 style="font-size: 15px;">@project.Title</h4>
                <span style="background: @(project.IsOpen ? "rgba(76,175,80,0.15)" : "rgba(176,176,176,0.15)"); color: @(project.IsOpen ? "var(--success)" : "var(--text-secondary)"); padding: 4px 12px; border-radius: 20px; font-size: 11px;">
                    @(project.IsOpen ? "باز" : "بسته")
                </span>
            </div>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 10px;">@project.Description</p>
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <span style="font-size: 14px; font-weight: 700; color: var(--primary);">@project.Budget.FormatPrice()</span>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <span style="background: rgba(255,107,53,0.15); color: var(--primary); padding: 3px 10px; border-radius: 12px; font-size: 11px;">
                        @project.Category.ToPersianName()
                    </span>
                    @if (project.Deadline.HasValue)
                    {
                        var remaining = (project.Deadline.Value - DateTime.UtcNow).Days;
                        <span style="font-size: 11px; color: var(--text-secondary);">
                            مهلت: @project.Deadline.Value.ToShamsiDate() (@remaining.ToPersianDigits() روز)
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    <div class="section-title">
        <h3>دسته‌بندی خدمات</h3>
    </div>

    <div class="services-grid">
        <a href="/freelancers" class="service-card">
            <div class="service-icon">🎬</div>
            <h4>فیلم‌برداری</h4>
        </a>
        <a href="/freelancers" class="service-card">
            <div class="service-icon">✂️</div>
            <h4>تدوین</h4>
        </a>
        <a href="/freelancers" class="service-card">
            <div class="service-icon">📱</div>
            <h4>ادمین اینستاگرام</h4>
        </a>
        <a href="/freelancers" class="service-card">
            <div class="service-icon">️</div>
            <h4>سناریو و مقاله</h4>
        </a>
        <a href="/freelancers" class="service-card">
            <div class="service-icon">🌐</div>
            <h4>ساخت سایت و سئو</h4>
        </a>
        <a href="/freelancers" class="service-card">
            <div class="service-icon">📊</div>
            <h4>مدیریت و رشد پیج</h4>
        </a>
    </div>

    <div class="section-title">
        <h3>فریلنسرهای برتر</h3>
        <a href="/freelancers">مشاهده همه</a>
    </div>

    @foreach (var freelancer in featuredFreelancers)
    {
        <div class="freelancer-card" @onclick='() => Navigation.NavigateTo($"/freelancers/{freelancer.Id}")'>
            <div class="freelancer-header">
                <div class="freelancer-avatar">
                    @freelancer.FullName[0]
                </div>
                <div class="freelancer-info" style="flex: 1;">
                    <h3>@freelancer.FullName</h3>
                    <p>@freelancer.Bio</p>
                </div>
                <span class="status-badge status-@freelancer.Status.ToString().ToLower()">
                    @freelancer.Status.ToPersianName()
                </span>
            </div>
            <div class="freelancer-meta">
                <div class="meta-item">
                    <span>⭐</span>
                    <span class="value">@freelancer.Rating.ToPersianDigits()</span>
                    <span>(@freelancer.TotalReviews.ToPersianDigits() نظر)</span>
                </div>
                <div class="meta-item">
                    <span></span>
                    <span class="value">@freelancer.CompletedProjects.ToPersianDigits()</span>
                    <span>پروژه</span>
                </div>
                <div class="meta-item">
                    <span>💰</span>
                    <span class="value">@freelancer.HourlyRate.FormatPrice()</span>
                    <span>/ ساعت</span>
                </div>
            </div>
            <div class="freelancer-skills">
                @foreach (var skill in freelancer.Skills.Take(3))
                {
                    <span class="skill-tag">@skill.ToPersianName()</span>
                }
            </div>
        </div>
    }

    <div class="section-title" style="margin-top: 10px;">
        <h3>عملکرد این ماه</h3>
    </div>

    <div class="chart-container">
        <div class="chart-bars">
            <div class="chart-bar" style="height: 40%;"></div>
            <div class="chart-bar" style="height: 65%;"></div>
            <div class="chart-bar" style="height: 55%;"></div>
            <div class="chart-bar" style="height: 80%;"></div>
            <div class="chart-bar" style="height: 70%;"></div>
            <div class="chart-bar" style="height: 90%;"></div>
            <div class="chart-bar" style="height: 75%;"></div>
        </div>
    </div>

    <NavMenu />
}

@code {
    private List<Shared.DTOs.FreelancerProfileDto> featuredFreelancers = new();
    private int activeProjects = 3;
    private int completedProjects = 12;
    private string totalSpent = "۰";
    private int freelancersCount = 0;
    private List<Shared.DTOs.ContentCalendarDto> upcomingEvents = new();
    private List<Shared.Models.Project> activeProjectList = new();

    protected override async Task OnInitializedAsync()
    {
        if (AppState.IsAuthenticated && AppState.UserId.HasValue)
        {
            featuredFreelancers = await FreelancerService.GetFeaturedFreelancersAsync();
            freelancersCount = featuredFreelancers.Count;
            var spent = await PaymentService.GetTotalSpentAsync(AppState.UserId.Value);
            totalSpent = spent.ToPersianDigits();

            upcomingEvents = await CalendarService.GetCalendarAsync(AppState.UserId.Value);
            upcomingEvents = upcomingEvents
                .Where(e => e.ScheduledDate >= DateTime.Today)
                .OrderBy(e => e.ScheduledDate)
                .ToList();

            activeProjectList = new List<Shared.Models.Project>
            {
                new() { Title = "فیلم‌برداری مراسم عروسی", Description = "فیلم‌برداری حرفه‌ای مراسم عروسی با دو دوربین و تجهیزات کامل", Category = ServiceCategory.Videography, Budget = 15_000_000, IsOpen = true, Deadline = DateTime.UtcNow.AddDays(20) },
                new() { Title = "مدیریت پیج اینستاگرام", Description = "مدیریت کامل پیج اینستاگرام شامل تولید محتوا، استوری و رشد فالوور", Category = ServiceCategory.InstagramAdmin, Budget = 8_000_000, IsOpen = true, Deadline = DateTime.UtcNow.AddDays(30) },
                new() { Title = "طراحی سایت فروشگاهی", Description = "طراحی و راه‌اندازی سایت فروشگاهی با ووکامرس", Category = ServiceCategory.WebDesign, Budget = 25_000_000, IsOpen = false, Deadline = DateTime.UtcNow.AddDays(-5) }
            };
        }
    }

    private void GoToProfile() => Navigation.NavigateTo("/profile");
    private void GoToSettings() => Navigation.NavigateTo("/settings");
}

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BetaChannels.Employer.Pages.GrowthManagementPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft">

    <Grid>
        <!-- Background Glow -->
        <BoxView HeightRequest="180" VerticalOptions="Start" HorizontalOptions="Fill">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30FF6B35" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Padding="16,0,16,20" Spacing="16">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,16,0,8">
                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="{RoundRectangle CornerRadius=12}"
                            BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderColor}">
                        <Label FontFamily="TablerIcons" Text="&#xea64;" FontSize="20"
                               TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers>
                    </Border>
                    <Label Grid.Column="1" Text="مدیریت رشد پیج" FontSize="20" FontFamily="VazirmatnBold"
                           TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                </Grid>

                <!-- Tab Switcher -->
                <Border Style="{StaticResource CardFrame}" Padding="4">
                    <Grid ColumnDefinitions="*,*">
                        <Border x:Name="EmployerTab" Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                                StrokeShape="{RoundRectangle CornerRadius=16}" Padding="0,12">
                            <Label Text="کارفرما" FontSize="14" FontFamily="VazirmatnBold" TextColor="White" HorizontalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEmployerTabTapped" /></Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="FreelancerTab" Grid.Column="1" BackgroundColor="Transparent"
                                StrokeShape="{RoundRectangle CornerRadius=16}" Padding="0,12">
                            <Label Text="فریلنسر" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFreelancerTabTapped" /></Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <!-- Employer Section -->
                <VerticalStackLayout x:Name="EmployerSection" Spacing="16">
                    <!-- Search Bar -->
                    <Border Style="{StaticResource CardFrame}" Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" FontFamily="TablerIcons" Text="&#xeb1c;" FontSize="20"
                                   TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="جستجوی فریلنسر..." Style="{StaticResource FormEntry}"
                                   BackgroundColor="Transparent" />
                        </Grid>
                    </Border>

                    <!-- Freelancer Cards -->
                    <Border Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="فریلنسرهای برتر" Style="{StaticResource SubheadingLabel}" />
                            <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="48"
                                            StrokeShape="{RoundRectangle CornerRadius=14}"
                                            BackgroundColor="{StaticResource Primary}">
                                        <Label Text="م" FontSize="18" FontFamily="VazirmatnBold" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="محمد رضایی" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="طراح گرافیک • ۴.۸ ★" FontSize="12" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="#1FFF6B35" StrokeShape="{RoundRectangle CornerRadius=10}" Padding="12,6">
                                        <Label Text="انتخاب" FontSize="12" FontFamily="VazirmatnBold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="48"
                                            StrokeShape="{RoundRectangle CornerRadius=14}"
                                            BackgroundColor="#4CAF50">
                                        <Label Text="ز" FontSize="18" FontFamily="VazirmatnBold" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="زهرا احمدی" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="تولید محتوا • ۴.۹ ★" FontSize="12" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="#1FFF6B35" StrokeShape="{RoundRectangle CornerRadius=10}" Padding="12,6">
                                        <Label Text="انتخاب" FontSize="12" FontFamily="VazirmatnBold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="48"
                                            StrokeShape="{RoundRectangle CornerRadius=14}"
                                            BackgroundColor="#2196F3">
                                        <Label Text="ع" FontSize="18" FontFamily="VazirmatnBold" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="علی محمدی" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="سئو و بازاریابی • ۴.۷ ★" FontSize="12" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="#1FFF6B35" StrokeShape="{RoundRectangle CornerRadius=10}" Padding="12,6">
                                        <Label Text="انتخاب" FontSize="12" FontFamily="VazirmatnBold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Freelancer Section (hidden by default) -->
                <VerticalStackLayout x:Name="FreelancerSection" Spacing="16" IsVisible="False">
                    <!-- Subscription Plans -->
                    <Border Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="پلن‌های اشتراک" Style="{StaticResource SubheadingLabel}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <Border Style="{StaticResource SmallCardFrame}" Padding="12,16">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label FontFamily="TablerIcons" Text="&#xf66a;" FontSize="28"
                                               TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                                        <Label Text="ویژه" FontSize="13" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                        <Label Text="۲۹۹ هزار" FontSize="11" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Style="{StaticResource SmallCardFrame}" Padding="12,16">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label FontFamily="TablerIcons" Text="&#xeb0a;" FontSize="28"
                                               TextColor="#4CAF50" HorizontalOptions="Center" />
                                        <Label Text="استوری" FontSize="13" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                        <Label Text="۱۹۹ هزار" FontSize="11" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Style="{StaticResource SmallCardFrame}" Padding="12,16">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label FontFamily="TablerIcons" Text="&#x10114;" FontSize="28"
                                               TextColor="#2196F3" HorizontalOptions="Center" />
                                        <Label Text="نمونه‌کار" FontSize="13" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                        <Label Text="رایگان" FontSize="11" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Advertising Rates -->
                    <Border Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="نرخ تبلیغات" Style="{StaticResource SubheadingLabel}" />
                            <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="نمایش ویژه در صفحه اصلی" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="مدت: ۷ روز" FontSize="12" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="۴۹۹,۰۰۰ ت" FontSize="14" FontFamily="VazirmatnBold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="استوری تبلیغاتی" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="مدت: ۲۴ ساعت" FontSize="12" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="۱۹۹,۰۰۰ ت" FontSize="14" FontFamily="VazirmatnBold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Shared Section -->
                <!-- Content Calendar Preview -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="10">
                            <Label FontFamily="TablerIcons" Text="&#xea53;" FontSize="20" TextColor="{StaticResource Primary}" />
                            <Label Text="تقویم محتوایی" Style="{StaticResource SubheadingLabel}" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="8">
                            <Label Text="ش" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="ی" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="2" Text="د" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="3" Text="س" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="4" Text="چ" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="5" Text="پ" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="6" Text="ج" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Border Grid.Row="1" Grid.Column="0" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource Primary}">
                                <Label Text="۱" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۲" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۳" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="#1FFF6B35">
                                <Label Text="۴" FontSize="12" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="4" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۵" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="5" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۶" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="6" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۷" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Payment Stats -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="10">
                            <Label FontFamily="TablerIcons" Text="&#xea59;" FontSize="20" TextColor="{StaticResource Primary}" />
                            <Label Text="آمار پرداخت‌ها" Style="{StaticResource SubheadingLabel}" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border Style="{StaticResource StatCard}">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                    <Label Text="۱,۲۰۰" FontSize="18" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                                    <Label Text="پرداخت شده" FontSize="11" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource StatCard}">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                    <Label Text="۳۵۰" FontSize="18" FontFamily="VazirmatnBold" TextColor="{StaticResource Warning}" HorizontalOptions="Center" />
                                    <Label Text="در انتظار" FontSize="11" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource StatCard}">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                    <Label Text="۸" FontSize="18" FontFamily="VazirmatnBold" TextColor="{StaticResource Success}" HorizontalOptions="Center" />
                                    <Label Text="پروژه فعال" FontSize="11" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Scenario Request Button -->
                <Button Text="دریافت سناریوی رشد" Style="{StaticResource FullWidthButton}" Clicked="OnScenarioRequested" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

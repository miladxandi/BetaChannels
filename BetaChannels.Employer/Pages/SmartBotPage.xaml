<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BetaChannels.Employer.Pages.SmartBotPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft">

    <Grid>
        <BoxView HeightRequest="180" VerticalOptions="Start" HorizontalOptions="Fill">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#30FF6B35" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Padding="16,0,16,20" Spacing="16">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,16,0,8">
                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="{RoundRectangle CornerRadius=12}"
                            BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderColor}">
                        <Label FontFamily="TablerIcons" Text="&#xea64;" FontSize="20"
                               TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Border.GestureRecognizers>
                    </Border>
                    <Label Grid.Column="1" Text="ربات هوشمند و نوبت‌دهی" FontSize="20" FontFamily="VazirmatnBold"
                           TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                </Grid>

                <!-- Platform Cards -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="پلتفرم‌های متصل" Style="{StaticResource SubheadingLabel}" />
                        <!-- Telegram -->
                        <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="{RoundRectangle CornerRadius=12}" BackgroundColor="#0088cc">
                                    <Label FontFamily="TablerIconsFilled" Text="&#x101ca;" FontSize="22" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="تلگرام" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="۱,۲۳۴ پیام • نرخ پاسخ: ۹۲٪" FontSize="11" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" BackgroundColor="{StaticResource Success}" StrokeShape="{RoundRectangle CornerRadius=10}" Padding="10,4">
                                    <Label Text="فعال" FontSize="10" FontFamily="VazirmatnBold" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Bale -->
                        <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="{RoundRectangle CornerRadius=12}" BackgroundColor="#00e09e">
                                    <Label FontFamily="TablerIconsFilled" Text="&#xf6a6;" FontSize="22" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="بله" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="۵۶۷ پیام • نرخ پاسخ: ۸۸٪" FontSize="11" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" BackgroundColor="{StaticResource Success}" StrokeShape="{RoundRectangle CornerRadius=10}" Padding="10,4">
                                    <Label Text="فعال" FontSize="10" FontFamily="VazirmatnBold" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Instagram Direct -->
                        <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="{RoundRectangle CornerRadius=12}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#833AB4" Offset="0" />
                                            <GradientStop Color="#FD1D1D" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label FontFamily="TablerIconsFilled" Text="&#xfecf;" FontSize="22" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="اینستاگرام دایرکت" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="۲,۸۹۰ پیام • نرخ پاسخ: ۷۵٪" FontSize="11" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" BackgroundColor="{StaticResource TextSecondary}" StrokeShape="{RoundRectangle CornerRadius=10}" Padding="10,4">
                                    <Label Text="غیرفعال" FontSize="10" FontFamily="VazirmatnBold" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Bot Settings -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="10">
                            <Label FontFamily="TablerIconsFilled" Text="&#xf69e;" FontSize="20" TextColor="{StaticResource Primary}" />
                            <Label Text="تنظیمات ربات" Style="{StaticResource SubheadingLabel}" />
                        </HorizontalStackLayout>
                        <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="پاسخ خودکار" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="ارسال پاسخ خودکار به پیام‌های جدید" FontSize="11" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="True" OnColor="{StaticResource Primary}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="ساعات کاری" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="۹ صبح تا ۶ عصر" FontSize="11" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="True" OnColor="{StaticResource Primary}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SmallCardFrame}" Padding="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="پاسخ سوالات متداول" FontSize="14" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="۱۲ سوال تنظیم شده" FontSize="11" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" FontFamily="TablerIcons" Text="&#xea61;" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Appointment System -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="10">
                            <Label FontFamily="TablerIcons" Text="&#xea53;" FontSize="20" TextColor="{StaticResource Primary}" />
                            <Label Text="نوبت‌دهی" Style="{StaticResource SubheadingLabel}" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="8">
                            <Label Text="ش" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="ی" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="2" Text="د" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="3" Text="س" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="4" Text="چ" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="5" Text="پ" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Label Grid.Column="6" Text="ج" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                            <Border Grid.Row="1" Grid.Column="0" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۱" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۲" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource Primary}">
                                <Label Text="۳" FontSize="12" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۴" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="4" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="#1FFF6B35">
                                <Label Text="۵" FontSize="12" TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="5" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۶" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="6" WidthRequest="32" HeightRequest="32" StrokeShape="{RoundRectangle CornerRadius=8}" BackgroundColor="{StaticResource SurfaceLight}">
                                <Label Text="۷" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="نوبت‌های امروز (۳ نوبت)" FontSize="13" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                        <Border Style="{StaticResource SmallCardFrame}" Padding="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="{RoundRectangle CornerRadius=10}" BackgroundColor="{StaticResource Primary}">
                                    <Label Text="۱" FontSize="14" FontFamily="VazirmatnBold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="سارا محمدی" FontSize="13" FontFamily="VazirmatnBold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="۱۰:۰۰ - مشاوره اولیه" FontSize="11" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" BackgroundColor="{StaticResource Success}" StrokeShape="{RoundRectangle CornerRadius=8}" Padding="8,3">
                                    <Label Text="تأیید" FontSize="10" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Quick Replies -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="10">
                            <Label FontFamily="TablerIconsFilled" Text="&#xfecf;" FontSize="20" TextColor="{StaticResource Primary}" />
                            <Label Text="پاسخ‌های سریع" Style="{StaticResource SubheadingLabel}" />
                        </HorizontalStackLayout>
                        <Border Style="{StaticResource SmallCardFrame}" Padding="12">
                            <Label Text="سلام! خوش آمدید. چطور می‌تونم کمکتون کنم؟" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        </Border>
                        <Border Style="{StaticResource SmallCardFrame}" Padding="12">
                            <Label Text="قیمت‌ها و پلن‌ها رو می‌تونید از بخش خدمات مشاهده کنید." FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        </Border>
                        <Button Text="افزودن پاسخ جدید" Style="{StaticResource OutlineButton}" HeightRequest="40" Clicked="OnAddReplyClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

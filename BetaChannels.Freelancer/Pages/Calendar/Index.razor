@page "/calendar"
@inject Shared.Interfaces.IContentCalendarService CalendarService
@inject NavigationManager Navigation

<div class="app-header">
    <div class="header-top">
        <div class="app-logo">
            <button class="header-btn" @onclick='() => Navigation.NavigateTo("/")'>
                <i class="bi bi-arrow-right"></i>
            </button>
            <div class="logo-text">تقویم محتوایی</div>
        </div>
        <div class="header-actions">
            <button class="header-btn" @onclick="ShowAddEvent">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
    </div>
</div>

<div class="page-content">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <button class="btn btn-outline" style="padding: 8px 16px;" @onclick="PreviousMonth">
            <i class="bi bi-chevron-right"></i>
        </button>
        <h3 style="font-size: 18px;">@currentMonthName @currentYear.ToPersianDigits()</h3>
        <button class="btn btn-outline" style="padding: 8px 16px;" @onclick="NextMonth">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <div class="calendar-header">
        <span>ش</span><span>ی</span><span>د</span><span>س</span><span>چ</span><span>پ</span><span>ج</span>
    </div>

    <div class="calendar-grid">
        @foreach (var day in calendarDays)
        {
            <div class="calendar-day @(day.IsToday ? "today" : "") @(day.IsOtherMonth ? "other-month" : "") @(day.HasEvent ? "has-event" : "")"
                 @onclick="() => SelectDay(day)">
                @day.DayNumber.ToPersianDigits()
            </div>
        }
    </div>

    <div class="section-title" style="padding: 0; margin-top: 20px;">
        <h3>رویدادهای @selectedDate.ToShamsiDateLong()</h3>
    </div>

    @if (dayEvents.Count == 0)
    {
        <div style="text-align: center; padding: 30px; color: var(--text-secondary); font-size: 14px;">
            رویدادی برای این روز ثبت نشده
        </div>
    }

    @foreach (var ev in dayEvents)
    {
        <div class="card" style="padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                    <h4 style="font-size: 15px; margin-bottom: 4px;">@ev.Title</h4>
                    <p style="font-size: 13px; color: var(--text-secondary);">@ev.Description</p>
                    <span style="background: rgba(255,107,53,0.15); color: var(--primary); padding: 3px 10px; border-radius: 12px; font-size: 11px; margin-top: 8px; display: inline-block;">
                        @ev.Platform.ToPersianName()
                    </span>
                    <span style="margin-right: 8px; font-size: 11px; color: var(--text-secondary);">
                        @ev.Status.ToPersianName()
                    </span>
                </div>
            </div>
        </div>
    }
</div>

@if (showAddEventForm)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 20px;">
        <div class="card" style="width: 100%; max-width: 500px;">
            <div class="card-header">
                <h3>افزودن رویداد</h3>
                <button class="header-btn" @onclick="() => showAddEventForm = false" style="background: rgba(255,255,255,0.1);">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="form-group">
                <label>عنوان</label>
                <input type="text" class="form-control" @bind="eventTitle" />
            </div>
            <div class="form-group">
                <label>توضیحات</label>
                <textarea class="form-control" @bind="eventDescription"></textarea>
            </div>
            <div class="form-group">
                <label>تاریخ (شمسی)</label>
                <div style="display: flex; gap: 8px; direction: ltr;">
                    <input type="number" class="form-control" placeholder="روز" @bind="eventShamsiDay" style="flex: 1; text-align: center;" min="1" max="31" />
                    <input type="number" class="form-control" placeholder="ماه" @bind="eventShamsiMonth" style="flex: 1; text-align: center;" min="1" max="12" />
                    <input type="number" class="form-control" placeholder="سال" @bind="eventShamsiYear" style="flex: 1.5; text-align: center;" />
                </div>
            </div>
            <div class="form-group">
                <label>پلتفرم</label>
                <select class="form-control" @bind="eventPlatform">
                    @foreach (var p in Enum.GetValues<Shared.Enums.SocialPlatform>())
                    {
                        <option value="@p">@p.ToPersianName()</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary btn-full" @onclick="SaveEvent">ذخیره</button>
        </div>
    </div>
}

<NavMenu />

@code {
    private static readonly System.Globalization.PersianCalendar persianCalendar = new();

    private DateTime currentDate = DateTime.Now;
    private DateTime selectedDate = DateTime.Now;
    private List<Shared.DTOs.ContentCalendarDto> allEvents = new();
    private List<Shared.DTOs.ContentCalendarDto> dayEvents = new();
    private List<CalendarDay> calendarDays = new();
    private bool showAddEventForm = false;
    private string eventTitle = "";
    private string eventDescription = "";
    private int eventShamsiDay = DateTime.Now.GetShamsiDay();
    private int eventShamsiMonth = DateTime.Now.GetShamsiMonth();
    private int eventShamsiYear = DateTime.Now.GetShamsiYear();
    private Shared.Enums.SocialPlatform eventPlatform = Shared.Enums.SocialPlatform.Instagram;

    private string currentMonthName => currentDate.GetShamsiMonthName();
    private int currentYear => currentDate.GetShamsiYear();

    protected override async Task OnInitializedAsync()
    {
        await LoadCalendar();
    }

    private async Task LoadCalendar()
    {
        allEvents = await CalendarService.GetCalendarAsync(Guid.Empty, currentDate);
        BuildCalendarDays();
        SelectDay(calendarDays.FirstOrDefault(d => d.IsToday) ?? calendarDays.First());
    }

    private void BuildCalendarDays()
    {
        calendarDays.Clear();

        var shamsiYear = currentDate.GetShamsiYear();
        var shamsiMonth = currentDate.GetShamsiMonth();

        // First day of the Shamsi month
        var firstDay = persianCalendar.ToDateTime(shamsiYear, shamsiMonth, 1, 0, 0, 0, 0);
        var daysInMonth = persianCalendar.GetDaysInMonth(shamsiYear, shamsiMonth);

        // Day of week for the first day (Saturday = 0 for our RTL week starting with شنبه)
        var dayOfWeek = (int)firstDay.DayOfWeek;
        // Convert: Saturday=0, Sunday=1, Monday=2, ..., Friday=6
        var startOffset = (dayOfWeek + 1) % 7;

        // Previous month days
        var prevMonthDays = persianCalendar.GetDaysInMonth(
            shamsiMonth == 1 ? shamsiYear - 1 : shamsiYear,
            shamsiMonth == 1 ? 12 : shamsiMonth - 1);

        for (int i = startOffset - 1; i >= 0; i--)
        {
            var dayNum = prevMonthDays - i;
            var month = shamsiMonth == 1 ? 12 : shamsiMonth - 1;
            var year = shamsiMonth == 1 ? shamsiYear - 1 : shamsiYear;
            var date = persianCalendar.ToDateTime(year, month, dayNum, 0, 0, 0, 0);
            calendarDays.Add(new CalendarDay { DayNumber = dayNum, IsOtherMonth = true, Date = date });
        }

        // Current month days
        for (int i = 1; i <= daysInMonth; i++)
        {
            var date = persianCalendar.ToDateTime(shamsiYear, shamsiMonth, i, 0, 0, 0, 0);
            calendarDays.Add(new CalendarDay
            {
                DayNumber = i,
                IsToday = date.Date == DateTime.Today,
                HasEvent = allEvents.Any(e => e.ScheduledDate.Date == date.Date),
                Date = date
            });
        }

        // Next month days to fill 42 cells (6 rows)
        var remaining = 42 - calendarDays.Count;
        for (int i = 1; i <= remaining; i++)
        {
            var month = shamsiMonth == 12 ? 1 : shamsiMonth + 1;
            var year = shamsiMonth == 12 ? shamsiYear + 1 : shamsiYear;
            var date = persianCalendar.ToDateTime(year, month, i, 0, 0, 0, 0);
            calendarDays.Add(new CalendarDay { DayNumber = i, IsOtherMonth = true, Date = date });
        }
    }

    private void SelectDay(CalendarDay day)
    {
        selectedDate = day.Date;
        dayEvents = allEvents.Where(e => e.ScheduledDate.Date == day.Date.Date).ToList();
    }

    private void PreviousMonth()
    {
        currentDate = currentDate.AddMonths(-1);
        BuildCalendarDays();
    }

    private void NextMonth()
    {
        currentDate = currentDate.AddMonths(1);
        BuildCalendarDays();
    }

    private void ShowAddEvent() => showAddEventForm = true;

    private async Task SaveEvent()
    {
        DateTime eventDate;
        try
        {
            eventDate = persianCalendar.ToDateTime(eventShamsiYear, eventShamsiMonth, eventShamsiDay, 0, 0, 0, 0);
        }
        catch
        {
            return;
        }

        await CalendarService.CreateEventAsync(Guid.Empty, new()
        {
            Title = eventTitle,
            Description = eventDescription,
            ScheduledDate = eventDate,
            Platform = eventPlatform
        });
        showAddEventForm = false;
        eventTitle = "";
        eventDescription = "";
        await LoadCalendar();
    }

    private class CalendarDay
    {
        public int DayNumber { get; set; }
        public bool IsToday { get; set; }
        public bool IsOtherMonth { get; set; }
        public bool HasEvent { get; set; }
        public DateTime Date { get; set; }
    }
}

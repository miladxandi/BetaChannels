@page "/divar/analytics"
@using BetaChannels.Shared.Interfaces
@inject IDivarService DivarService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="dashboard-container" dir="rtl">
    <div class="page-header">
        <h1>📊 آمار آگهی‌های دیوار</h1>
        <button class="btn btn-outline" @onclick="RefreshData">بروزرسانی</button>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div>در حال دریافت اطلاعات آگهی‌ها...</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <div style="font-size: 48px; margin-bottom: 16px;">⚠️</div>
            <h3>خطا در دریافت اطلاعات</h3>
            <p>@errorMessage</p>
            <button class="btn btn-primary" @onclick="LoadPosts" style="margin-top: 16px;">تلاش مجدد</button>
        </div>
    }
    else if (posts == null || !posts.ToString()!.Contains("["))
    {
        <div class="empty-state">
            <div style="font-size: 48px; margin-bottom: 16px;">📭</div>
            <h3>آگهی یافت نشد</h3>
            <p>هیچ آگهی فعالی در حساب دیوار شما یافت نشد.</p>
        </div>
    }
    else
    {
        <div class="posts-grid">
            @foreach (var post in postList)
            {
                <div class="post-card @(selectedPostToken == post.Token ? "selected" : "")"
                     @onclick="() => SelectPost(post.Token)">
                    <h3>@post.Title</h3>
                    @if (post.Status is not null)
                    {
                        <span class="post-status">@post.Status</span>
                    }
                </div>
            }
        </div>

        @if (selectedPostToken is not null)
        {
            <div class="stats-section">
                @if (isLoadingStats)
                {
                    <div class="loading-state">در حال دریافت آمار...</div>
                }
                else if (postStats is not null)
                {
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-value">@postStats.TotalViews</div>
                            <div class="stat-label">بازدید کل</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-value">@postStats.TotalImpressions</div>
                            <div class="stat-label">نمایش کل</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-value">@postStats.TotalChats</div>
                            <div class="stat-label">چت‌ها</div>
                        </div>
                    </div>

                    @if (postStats.DailyStats is not null && postStats.DailyStats.Count > 0)
                    {
                        <div class="chart-section">
                            <h3>آمار ۷ روز اخیر</h3>
                            <div class="daily-stats-table">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>تاریخ</th>
                                            <th>بازدید</th>
                                            <th>نمایش</th>
                                            <th>چت</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var day in postStats.DailyStats)
                                        {
                                            <tr>
                                                <td>@day.Date</td>
                                                <td>@day.Views</td>
                                                <td>@day.Impressions</td>
                                                <td>@day.Chats</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private bool isLoadingStats;
    private string? errorMessage;
    private object? posts;
    private List<PostSummary> postList = new();
    private string? selectedPostToken;
    private PostStatsData? postStats;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPosts();
    }

    private async Task LoadPosts()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await DivarService.GetUserPostsAsync();
            if (result.Success)
            {
                posts = result.Posts;
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "خطا در دریافت آگهی‌ها";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectPost(string token)
    {
        selectedPostToken = token;
        await LoadStats(token);
    }

    private async Task LoadStats(string token)
    {
        isLoadingStats = true;
        try
        {
            var result = await DivarService.GetPostStatsAsync(token);
            if (result.Success)
            {
                postStats = new PostStatsData
                {
                    TotalViews = 0,
                    TotalImpressions = 0,
                    TotalChats = 0,
                    DailyStats = new List<DailyStat>(),
                };
            }
        }
        finally
        {
            isLoadingStats = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadPosts();
        if (selectedPostToken is not null)
        {
            await LoadStats(selectedPostToken);
        }
    }

    private class PostSummary
    {
        public string Token { get; set; } = "";
        public string Title { get; set; } = "";
        public string? Status { get; set; }
        public string? ImageUrl { get; set; }
    }

    private class PostStatsData
    {
        public int TotalViews { get; set; }
        public int TotalImpressions { get; set; }
        public int TotalChats { get; set; }
        public List<DailyStat>? DailyStats { get; set; }
    }

    private class DailyStat
    {
        public string Date { get; set; } = "";
        public int Views { get; set; }
        public int Impressions { get; set; }
        public int Chats { get; set; }
    }
}

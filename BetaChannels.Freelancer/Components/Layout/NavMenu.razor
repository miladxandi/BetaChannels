<nav class="bottom-nav">
    <a href="/" class="nav-item @(IsActive("/") ? "active" : "")">
        <i class="bi bi-house-fill"></i>
        <span>خانه</span>
    </a>
    <a href="/services" class="nav-item @(IsActive("/services") ? "active" : "")">
        <i class="bi bi-grid-fill"></i>
        <span>خدمات</span>
    </a>
    <a href="/calendar" class="nav-item @(IsActive("/calendar") ? "active" : "")">
        <i class="bi bi-calendar-event-fill"></i>
        <span>تقویم</span>
    </a>
    <a href="/payments" class="nav-item @(IsActive("/payments") ? "active" : "")">
        <i class="bi bi-wallet2"></i>
        <span>پرداخت</span>
    </a>
    <a href="/settings" class="nav-item @(IsActive("/settings") ? "active" : "")">
        <i class="bi bi-gear-fill"></i>
        <span>تنظیمات</span>
    </a>
</nav>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool IsActive(string path)
    {
        var current = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        var target = path.TrimEnd('/');
        return target == "" ? current == "" : current == target || current.StartsWith(target + "/");
    }
}
